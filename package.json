{
  "name": "ro-launcher",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:nndsk": "npm run tauri:build:appimage && npm run install:nndsk",
    "install:nndsk": "node scripts/install-nndsk.mjs",
    "test": "vitest run",
    "lint": "eslint src vite.config.ts",
    "format": "prettier --write src vite.config.ts",
    "format:check": "prettier --check src vite.config.ts",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:dev": "cargo build -p ro-inputd -p ro-sessiond && GDK_BACKEND=x11 WEBKIT_DISABLE_DMABUF_RENDERER=1 tauri dev",
    "tauri:build": "cargo build -p ro-inputd -p ro-sessiond --release && tauri build",
    "tauri:build:appimage": "cargo build -p ro-inputd -p ro-sessiond --release && NO_STRIP=true tauri build --bundles appimage"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.7.3",
    "lucide-react": "^1.45.0",
    "react": "^19",
    "react-dom": "^19",
    "zustand": "^5"
  },
  "devDependencies": {
    "@babel/core": "^8.0.5",
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "^2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10",
    "esbuild": "^0.28.2",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "jsdom": "^30.0.1",
    "postcss": "^8",
    "prettier": "^3.9.6",
    "tailwindcss": "^4",
    "typescript": "^7",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.0"
  }
}
