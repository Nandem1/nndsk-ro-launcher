{
  "name": "ro-launcher",
  "private": true,
  "version": "0.3.3",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:nndsk": "npm run tauri:build:appimage && npm run install:nndsk",
    "install:nndsk": "node scripts/install-nndsk.mjs",
    "test": "vitest run",
    "lint": "eslint src vite.config.ts",
    "format": "prettier --write src vite.config.ts",
    "format:check": "prettier --check src vite.config.ts",
    "check:design": "node scripts/check-design.mjs",
    "check:design:fixtures": "node scripts/test-design-guards.mjs",
    "check:design:fit": "node scripts/test-design-fit.mjs",
    "review:design": "node scripts/review-design.mjs",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:dev": "cargo build -p ro-inputd -p ro-sessiond && GDK_BACKEND=x11 WEBKIT_DISABLE_DMABUF_RENDERER=1 tauri dev",
    "tauri:build": "cargo build -p ro-inputd -p ro-sessiond --release && tauri build",
    "tauri:build:appimage": "cargo build -p ro-inputd -p ro-sessiond --release && NO_STRIP=true tauri build --bundles appimage",
    "version:show": "node scripts/bump-version.mjs --show",
    "version:bump": "node scripts/bump-version.mjs"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.8.3",
    "lucide-react": "^1.59.0",
    "react": "^19",
    "react-dom": "^19",
    "zustand": "^5"
  },
  "devDependencies": {
    "@babel/core": "^8.0.7",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/node": "^4.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.12.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.2",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "jsdom": "^30.1.3",
    "playwright": "^1.64.1",
    "postcss": "^8",
    "postcss-selector-parser": "^7.1.6",
    "postcss-value-parser": "^4.2.0",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "typescript": "^7",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
