{
  "$schema": "https://schema.tauri.app/config/capability/2",
  "identifier": "default",
  "description": "Default capabilities for RO Launcher",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-close",
    "core:window:allow-minimize",
    "core:window:allow-start-dragging",
    "dialog:default",
    "updater:deny-check",
    "updater:deny-download",
    "updater:deny-download-and-install",
    "updater:deny-install"
  ]
}
