{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RO-Launcher",
  "version": "0.2.1",
  "identifier": "com.nndsk.ro-launcher",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "RO-Launcher",
        "decorations": false,
        "width": 1280,
        "height": 820,
        "resizable": false,
        "backgroundColor": "#09090b",
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/ro-inputd",
      "binaries/ro-sessiond"
    ],
    "resources": {
      "resources/dgvoodoo/": "dgvoodoo/"
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDJFODc3OTI5NTEzN0NBMzQKUldRMHlqZFJLWG1ITGdzcGpoNXhLM2FsbU1WcWgrTllVRHJZMEJzS2dJcDBJL2U1ZUQ0aDJudTMK",
      "endpoints": [
        "https://github.com/Nandem1/nndsk-ro-launcher/releases/latest/download/latest.json"
      ],
      "requireSignedVersion": true
    }
  }
}
